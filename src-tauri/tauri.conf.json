{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mac Cleanup",
  "version": "0.1.0",
  "identifier": "dev.stackpicks.maccleanup",
  "build": {
    "beforeDevCommand": "",
    "beforeBuildCommand": "",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../src"
  },
  "app": {
    "windows": [
      {
        "title": "Mac Cleanup",
        "width": 900,
        "height": 640,
        "minWidth": 780,
        "minHeight": 560,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "app", "msi", "nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Utility",
    "shortDescription": "Safely free up disk space",
    "longDescription": "Mac Cleanup finds unnecessary caches and files, classifies each finding by safety, and moves the ones you approve to Trash. Nothing is ever deleted without your explicit confirmation. Fully local, no network calls.",
    "publisher": "StackPicks",
    "copyright": "© 2026 StackPicks",
    "macOS": {
      "minimumSystemVersion": "12.0",
      "hardenedRuntime": true
    },
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": ""
    }
  }
}
